#!/usr/bin/env bash
# .githooks/pre-commit: block commits that contain secrets (gitleaks).
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
	echo "pre-commit: gitleaks not found; install it before committing." >&2
	exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
