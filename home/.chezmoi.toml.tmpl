{{- /* chezmoi config, generated by `chezmoi init`. The installer passes name/email from existing git config. */ -}}
{{- $name := promptStringOnce . "name" "git name" -}}
{{- $email := promptStringOnce . "email" "git email" -}}
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
