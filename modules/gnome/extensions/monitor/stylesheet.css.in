/* No fixed colours: text follows the theme (light, dark, palette accents). Nothing is dimmed: on glass,
   dimmed text fell below 4.5:1 contrast; state shows by shape (outline/filled star). */
.ost-monitor-panel { spacing: 10px; }
.ost-monitor-item { spacing: 3px; }
.ost-monitor-icon { icon-size: [[icon_s]]; padding: 0; }
.ost-monitor-value { font-feature-settings: "tnum"; }

/* The popup keeps this width, in em so it grows with the text size. Long values end in "…" instead of
   widening it. */
.ost-monitor-menu { width: 18em; }
/* An open section sits on the glass like the rows above it (no second grey surface), and fades at the
   edge where it scrolls (its height is capped in extension.js, from the section-rows setting). */
.ost-monitor-menu .popup-sub-menu { background-color: transparent; box-shadow: none; border-width: 0; -st-vfade-offset: 1em; }
/* The popup: a section per kind of reading, a row per value, values lined up on the right.
   Compact: the theme's menu rows are built for touch; these are a line each. */
.ost-vital-section { padding-top: 5px; padding-bottom: 5px; min-height: 0; }
.ost-vital-section .popup-menu-icon { icon-size: [[icon_s]]; }
.ost-vital-summary { font-feature-settings: "tnum"; padding: 0; }
/* One row is (1.3 + 0.2 + 0.2) x 0.95 = 1.62em of the menu's text size (about 24 px): the height cap in
   extension.js counts rows of that size, and the floor stops St squeezing them. */
.ost-vital-row { spacing: 10px; padding-top: 0.2em; padding-bottom: 0.2em; min-height: 1.3em; font-size: 0.95em; }
.ost-vital-value { font-feature-settings: "tnum"; text-align: right; }
.ost-vital-star { icon-size: [[icon_s]]; }
.ost-vital-footer { spacing: [[space_xs]]; padding: 2px [[space_m]]; }
/* 24 px to hit at least (WCAG 2.5.8) at the default text size, in em so it grows with the text: an
   icon and 0.27em of padding make up target_comfort. */
.ost-vital-button { padding: 0.27em; border-radius: [[radius_pill]]; min-width: [[target_comfort]]; min-height: [[target_comfort]]; }
.ost-vital-button .popup-menu-icon { icon-size: [[icon_s]]; }

.ost-monitor-line { padding: 3px [[space_m]]; font-feature-settings: "tnum"; }
.ost-monitor-heading { font-weight: bold; padding-top: [[space_s]]; }
.ost-monitor-note { font-size: smaller; }
/* Key focus on the footer buttons: the shell's ring is the accent colour, which
   measured 1.6 to 2.8:1 on light glass. A ring in the scheme's text colour is the most
   contrasting one in either style (keyed off .ost-blur-light, like the other glass rules).
   shortcut: only inside blur's glass (.ost-blur-menu); with blur off the shell's accent ring stays,
   upgrade with a style-independent ring token if that matters. */
.ost-blur-menu .ost-vital-button:focus { box-shadow: inset 0 0 0 2px {{text}}; }
.ost-blur-light .ost-blur-menu .ost-vital-button:focus { box-shadow: inset 0 0 0 2px {{light_text}}; }
/* On glass, the footer buttons and an open section's header take the glass tint, not the theme's solid
   grey (owner, 2026-11-18); hover a step stronger. */
.ost-blur-menu .ost-vital-button,
.ost-blur-menu .ost-vital-section:checked { background-color: {{glass_banner}}; }
.ost-blur-menu .ost-vital-button:hover,
.ost-blur-menu .ost-vital-section:checked:hover { background-color: {{glass_folder}}; }
.ost-blur-light .ost-blur-menu .ost-vital-button,
.ost-blur-light .ost-blur-menu .ost-vital-section:checked { background-color: {{light_glass_banner}}; }
.ost-blur-light .ost-blur-menu .ost-vital-button:hover,
.ost-blur-light .ost-blur-menu .ost-vital-section:checked:hover { background-color: {{light_glass_folder}}; }

/* The pop-out alert (_lib/alert.js): a dark card just under the top bar. Opaque enough to read over
   anything without a blur behind it; one accent button style, the confirming state in red. */
.ost-alert {
  background-color: rgba(28, 30, 36, 0.96);
  color: #ffffff; /* token-lint: allow fixed card colour */
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: [[radius_card]];
  padding: [[space_m]] 14px [[space_m]] 14px;
  spacing: [[space_s]];
}
.ost-alert-head { spacing: 10px; }
.ost-alert-icon { icon-size: 24px; }
.ost-alert-title { font-weight: bold; }
.ost-alert-body { color: rgba(255, 255, 255, 0.86); }
.ost-alert-close { padding: [[space_xs]]; border-radius: 99px; min-width: [[target_min]]; min-height: [[target_min]]; color: #ffffff; } /* token-lint: allow fixed card colour */
.ost-alert-close:hover, .ost-alert-close:focus { background-color: rgba(255, 255, 255, 0.14); }
.ost-alert-buttons { spacing: 8px; padding-top: [[space_s]]; }
.ost-alert-button {
  padding: [[space_s]] 14px;
  border-radius: 99px;
  min-height: [[target_min]];
  font-weight: bold;
  color: #ffffff; /* token-lint: allow fixed card colour */
  background-color: rgba(255, 255, 255, 0.12);
}
.ost-alert-button:hover { background-color: rgba(255, 255, 255, 0.20); }
.ost-alert-button:focus { box-shadow: inset 0 0 0 2px -st-accent-color; }
.ost-alert-confirm { background-color: #c01c28; } /* token-lint: allow fixed card colour */
.ost-alert-confirm:hover { background-color: #d32733; } /* token-lint: allow fixed card colour */
