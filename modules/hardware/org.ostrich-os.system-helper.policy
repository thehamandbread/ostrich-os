<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MIT -->
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- One action per thing the helper does, picked by its first argument (pkexec matches exec.argv1).
     Power and the touchscreen run without a password for the person at the machine, so the switch to
     power saver at low battery never stops at a prompt; changing the graphics mode asks. Anything
     else falls to pkexec's own default, which asks for an administrator. To change a default, add a
     rule in /etc/polkit-1/rules.d/ (docs/DEFAULTS.md). -->
<policyconfig>
  <vendor>Ostrich OS</vendor>
  <action id="org.ostrich-os.system-helper.power">
    <description>Apply a power mode's hardware settings</description>
    <message>Authentication is required to change power settings</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/ostrich-os/system-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">power</annotate>
  </action>
  <action id="org.ostrich-os.system-helper.touchscreen">
    <description>Turn the touchscreen on or off</description>
    <message>Authentication is required to turn the touchscreen on or off</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/ostrich-os/system-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">touchscreen</annotate>
  </action>
  <action id="org.ostrich-os.system-helper.graphics">
    <description>Change the graphics mode</description>
    <message>Change the graphics mode. You'll need to log out afterwards.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/ostrich-os/system-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">graphics</annotate>
  </action>
  <action id="org.ostrich-os.system-helper.apparmor">
    <description>Let an app from GitHub use its sandbox</description>
    <message>Let an app you installed from GitHub use its security sandbox (an AppArmor rule).</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/ostrich-os/system-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">apparmor</annotate>
  </action>
</policyconfig>
